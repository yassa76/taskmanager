generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // connessione pooled (pgbouncer), usata a runtime
  directUrl = env("DIRECT_URL")   // connessione diretta, usata solo dalle migration
}

// ---------- NextAuth required models ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- App models ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  firstName     String?
  lastName      String?
  themeColor    String    @default("blue") // "blue" | "orange" | "green" | "purple" | "red" | "teal" | "pink"
  image         String?
  role          String    @default("normal") // "admin" | "normal" | "read_only"
  createdAt     DateTime  @default(now())
  lastActiveAt  DateTime? // ultima volta che la persona ha usato davvero l'app (non solo tenuto la finestra aperta)

  accessLogs AccessLog[]
  accounts Account[]
  sessions Session[]

  teamMember   TeamMember? @relation(fields: [teamMemberId], references: [id])
  teamMemberId String?     @unique

  ownedTasks    Task[]    @relation("TaskOwner")
  ownedSubtasks Subtask[] @relation("SubtaskOwner")
  ownedClients  Client[]  @relation("ClientOwner")

  createdTasks    Task[]    @relation("TaskCreatedBy")
  createdSubtasks Subtask[] @relation("SubtaskCreatedBy")
  createdClients  Client[]  @relation("ClientCreatedBy")

  activityLogs ActivityLog[]

  comments      Comment[]      @relation("CommentAuthor")
  notifications Notification[] @relation("NotificationRecipient")
}

// Elenco email del team, gestito dagli admin. Quando un utente si registra
// (login Google) con un'email presente qui, viene fatto il match automatico.
// Ogni membro ha subito un account "segnaposto" creato all'invito, cosi'
// puo' essere assegnato come owner anche prima di essersi mai loggato.
model TeamMember {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("new") // "new" | "invited" | "active" | "inactive"
  invitedAt DateTime @default(now())

  user User?
}
model Client {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  industry    String?   // "GPS" | "TMT" | "ER&I" | "FSI" | "CONS"
  status      String    @default("attivo") // "attivo" | "inattivo": se inattivo, non selezionabile per nuovi task
  address     String?   // via e numero civico
  country     String?   // codice ISO a 2 lettere: "IT" | "SA" | "AE" | "DE" (o altro se arriva dal geocoding)
  province    String?   // Italia: sigla (es. "MI"); altri paesi: regione/stato, solo da geocoding
  city        String?   // Italia: nome del comune; altri paesi: solo da geocoding
  ownerId     String?
  owner       User?     @relation("ClientOwner", fields: [ownerId], references: [id])
  projects    Project[]
  tasks       Task[]    @relation("ClientTasks")
  createdById String?
  createdBy   User?     @relation("ClientCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
}

model Project {
  id       String @id @default(cuid())
  name     String
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks    Task[]
  createdAt DateTime @default(now())

  @@unique([clientId, name])
}

model Task {
  id             String    @id @default(cuid())
  title          String
  description    String?
  startDate      DateTime?
  endDate        DateTime?
  ownerId        String
  owner          User      @relation("TaskOwner", fields: [ownerId], references: [id])
  clientId       String?
  client         Client?   @relation("ClientTasks", fields: [clientId], references: [id])
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id])
  closedManually Boolean   @default(false)
  statusOverride String?
  createdById String?
  createdBy   User?    @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subtasks Subtask[]
}

model Subtask {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("da_avviare") // "da_avviare" | "in_corso" | "completato"
  startDate   DateTime  @default(now())
  endDate     DateTime?  // Data di scadenza (deadline)
  closedAt    DateTime?  // Data di chiusura effettiva (quando e' stato completato)
  ownerId     String
  owner       User      @relation("SubtaskOwner", fields: [ownerId], references: [id])
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation("SubtaskCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Ricorrenza: null = sub-task singolo. Quando un sub-task ricorrente viene chiuso
  // ("Completato") ne nasce uno nuovo nello stesso task, con le date spostate di un intervallo.
  recurrence         String?   // "weekly" | "biweekly" | "monthly" | "quarterly" | "semiannual" | "yearly"
  recurrenceEndDate  DateTime? // facoltativa: oltre questa data la serie si ferma
  recurrenceSourceId String?   @unique // sub-task da cui questo e' stato generato
  recurrenceSource   Subtask?  @relation("SubtaskRecurrence", fields: [recurrenceSourceId], references: [id], onDelete: SetNull)
  recurrenceNext     Subtask?  @relation("SubtaskRecurrence")
}

model ActivityLog {
  id         String   @id @default(cuid())
  entityType String   // "task" | "subtask" | "client"
  entityId   String
  action     String   // "creato" | "stato" | "owner" | "eliminato"
  detail     String?  // es. "Da avviare -> In corso", "Mario Rossi -> Luca Bianchi"
  entityLabel String? // titolo/nome del record al momento dell'azione (utile dopo un'eliminazione)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// Ogni login: serve all'admin per vedere chi si e' collegato e quando. Solo utente e orario.
model AccessLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// Impostazioni dell'applicazione modificabili dagli admin (chiave/valore).
// Es. "geocode.dailyLimit", "geocode.monthlyLimit".
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Contatore giornaliero delle chiamate a Google Geocoding. "day" e' la data nel
// fuso Pacifico (YYYY-MM-DD), lo stesso usato da Google per azzerare le quote.
model GeocodeUsage {
  day   String @id
  count Int    @default(0)
}

// Commenti su task e sub-task. Nel testo le menzioni sono salvate come
// @[Nome](idUtente), cosi' restano corrette anche se il nome cambia.
model Comment {
  id         String    @id @default(cuid())
  entityType String    // "task" | "subtask"
  entityId   String
  authorId   String
  author     User      @relation("CommentAuthor", fields: [authorId], references: [id])
  body       String    @db.Text
  createdAt  DateTime  @default(now())
  editedAt   DateTime?

  notifications Notification[]

  @@index([entityType, entityId, createdAt])
}

// Avvisi in-app (campanella). Uno per destinatario e per commento.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason    String    // "menzione" | "owner" | "thread"
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}
